# Node
node_modules/
dist/
build/
*.tgz
dist-pack/
npm-debug.log*
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
parity/.vitest-report.json

# Environment
.env
.env.*
!.env.example

# Secrets
*.pem
*.key
secrets.json
# NOTE: .secrets.baseline is intentionally tracked — it is referenced by the
# detect-secrets hook in .pre-commit-config.yaml and must ship with the repo.
# Do not add it back to .gitignore.

# OS
.DS_Store
Thumbs.db

# Temporary diff/patch files
*.diff
current_diff.patch
diff-code.txt

# Local scratch/verification workspaces
.scratch-*/

# Sandbox config (may contain API keys)
~/.sbox/

# Benchmarks output
benchmarks/*.log

# NOTE: .agents/ (notes, design, evidence, research) is fully tracked; do not ignore any part of it.

scripts/local-paths.private
