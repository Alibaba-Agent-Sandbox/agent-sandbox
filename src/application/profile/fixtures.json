      "name": "agents-api",
      "version": "0.1.4",
      "description": "One stable Gateway for session-owned Sandbox Agents, durable files and explicit lifecycle.",
      "author": "alibaba-agent-sandbox",
      "license": "Apache-2.0",
      "spec_version": 6,
      "base": "fc-e2b-registry.<region>.cr.aliyuncs.com/runtime/base:<tag>",
      "generation": 2,
      "start_cmd": "python -m agent_sandbox.server.managed --port 9000",
      "ready_cmd": "agent-sandbox-server healthcheck --port 9000",
      "resources": {
        "cpu": 2,
        "memory": 4096
      },
      "ports": [
        9000
      ],
      "tags": [
        "agents-api",
        "gateway",
        "sessions",
        "qwen-code",
        "codex"
      ],
      "priority": "P1",
      "wave": 1,
      "env": {
        "ABX_SERVER_TOKEN": "",
        "OPENAI_API_KEY": "",
        "OPENAI_BASE_URL": "",
        "OPENAI_MODEL": "",
        "ABX_MANAGED_WORKSPACE": "/workspace",
        "ABX_MANAGED_STATE_DIR": "/home/user/.agent-sandbox/managed-bridge"
      },
      "smoke": [
        {
          "operation": "health",
          "expect": {
            "status": "ok",
            "protocol": "agent-sandbox-managed-bridge/v1"
          }
        },
        {
          "operation": "capabilities",
          "expect": {
            "durable_receipts": true
          }
        }
      ],
      "provides": {
        "app": {
          "protocol": "agent-sandbox-managed-bridge",
          "version": 1,
          "port": 9000,
          "operations": [
            "health",
            "capabilities",
            "session.create",
            "session.get",
            "submissions.create",
            "submissions.get",
            "submissions.cancel"
          ]
        }
      },
      "application": {
        "api": {
          "protocol": "agent-sandbox-managed-agents/v1",
          "compatibility": "openai-agents-inspired-subset",
          "busyInputPolicy": "reject-unless-steerable",
          "explicitQueue": true
        },
        "runtime": {
          "placement": "in-sandbox",
          "driver": "sandbox-local-api",
          "profile": "managed-bridge-v1"
        },
        "gateway": {
          "placement": "fc-web"
        },
        "sandbox": {
          "provider": "alicloud-express",
          "lifetime": "per-session",
          "workspace": "exclusive",
          "requiredFeatures": [
            "sandbox.lifecycle",
            "ports.url"
          ]
        },
        "sessions": {
          "idleTimeoutSeconds": 900,
          "maxLifetimeSeconds": 3600,
          "maxLogicalSessionsPerOwner": 100,
          "maxActiveSessions": 20,
          "maxQueuedTurnsPerSession": 8,
          "maxConcurrentTurnsPerSession": 1,
          "resultRetentionSeconds": 86400,
          "closePolicy": "release-compute-retain-results",
          "deletePolicy": "remove-public-data-retain-private-cleanup",
          "guestRestartPolicy": "freeze-and-reconcile"
        },
        "state": {
          "profile": "durable",
          "bindingRef": "state"
        },
        "storage": {
          "backend": "bounded-database",
          "maxFileBytes": 10485760,
          "maxArtifactBytes": 10485760,
          "maxTurnArtifactBytes": 10485760,
          "maxRetainedBytesPerOwner": 104857600
        },
        "bindings": {
          "state": {
            "reference": "agents-state",
            "targets": [
              "gateway",
              "worker",
              "dispatcher"
            ]
          },
          "sandboxAccess": {
            "reference": "agents-sandboxAccess",
            "targets": [
              "worker",
              "dispatcher"
            ]
          },
          "model": {
            "reference": "agents-model",
            "targets": [
              "sandbox-creation"
            ],
            "resolverRole": "worker",
            "allowedEnv": [
              "OPENAI_API_KEY",
              "OPENAI_BASE_URL",
              "OPENAI_MODEL"
            ]
          },
          "clientAuth": {
            "reference": "agents-clientAuth",
            "targets": [
              "gateway"
            ]
          },
          "internalAuth": {
            "reference": "agents-internalAuth",
            "targets": [
              "gateway",
              "worker",
              "dispatcher"
            ]
          },
          "ingress": {
            "reference": "agents-ingress",
            "targets": [
              "deployment-publisher"
            ]
          }
        },
        "limits": {
          "maxRunSeconds": 600,
          "maxToolSeconds": 60,
          "maxConcurrentRuns": 10,
          "maxQueuedRuns": 80,
          "maxRunsPerMinute": 60,
          "maxEventsPerRun": 10000,
          "maxOutputBytes": 8388608,
          "maxSubscribersPerSession": 4
        },
        "deployment": {
          "profile": "fc-managed-agents",
          "accessRef": "default",
          "region": "cn-hangzhou",
          "component": "fc3@0.1.26",
          "serverBuildRecipe": {
            "dockerfile": "server/Dockerfile",
            "context": "."
          },
          "ingressBindingRef": "ingress",
          "revisionStrategy": "immutable-workers-with-drain"
        },
        "outputs": {
          "endpoint": {
            "from": "publish.outputs.endpoint"
          },
          "protocol": "agent-sandbox-managed-agents/v1"
        },
        "hooks": {
          "afterReady": [
            {
              "id": "managed-agent-business",
              "type": "custom",
              "argv": [
                "python",
                "scripts/smoke.py"
              ],
              "cwd": ".",
              "timeoutSeconds": 900,
              "envAllowlist": []
            }
          ]
        }
      }
    },
