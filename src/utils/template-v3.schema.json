{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Alibaba-Agent-Sandbox/awesome-templates/main/schema/template-v3.schema.json",
  "title": "Agent Sandbox template specification v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "author",
    "license",
    "spec_version",
    "base",
    "generation",
    "start_cmd",
    "ready_cmd",
    "resources",
    "ports",
    "tags",
    "priority",
    "wave",
    "tested_on",
    "capabilities",
    "env",
    "smoke"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(?:_skeleton|[a-z0-9][a-z0-9-]{0,62})$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "start_cmd": {
      "type": "string",
      "minLength": 1
    },
    "ready_cmd": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "const": 3
    },
    "generation": {
      "const": 2
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "integer",
          "minimum": 128,
          "multipleOf": 64
        }
      }
    },
    "ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "contains": {
        "const": 9000
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "wave": {
      "enum": [
        1,
        2,
        3,
        "other"
      ]
    },
    "tested_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "shell",
          "files",
          "code",
          "terminal",
          "ports"
        ]
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "smoke": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "expect"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          },
          "expect": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "application": {
      "$ref": "#/$defs/application"
    }
  },
  "$defs": {
    "refName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00-\\x1f]+$"
    },
    "hooks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executor",
          "argv",
          "cwd",
          "timeoutSeconds",
          "envAllowlist"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/refName"
          },
          "executor": {
            "const": "host-command"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "cwd": {
            "$ref": "#/$defs/relativePath"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          },
          "envAllowlist": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "gateway",
        "deployment",
        "sandbox",
        "state",
        "bindings",
        "limits"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "driver"
          ],
          "properties": {
            "placement": {
              "enum": [
                "external",
                "in-sandbox"
              ]
            },
            "driver": {
              "enum": [
                "python-remote-tools",
                "sandbox-local-api"
              ]
            },
            "profile": {
              "enum": [
                "server-core-agents",
                "legacy-codex-agent-api"
              ]
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement"
          ],
          "properties": {
            "placement": {
              "enum": [
                "fc-web",
                "client-direct"
              ]
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter"
          ],
          "properties": {
            "adapter": {
              "enum": [
                "none",
                "serverless-devs-fc3"
              ]
            },
            "project": {
              "$ref": "#/$defs/relativePath"
            },
            "toolchainLock": {
              "$ref": "#/$defs/relativePath"
            },
            "accessRef": {
              "$ref": "#/$defs/refName"
            },
            "inline": {
              "$ref": "#/$defs/serverlessProject"
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "lifetime",
            "workspace",
            "requiredFeatures"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/refName"
            },
            "lifetime": {
              "const": "per-run"
            },
            "workspace": {
              "const": "exclusive"
            },
            "requiredFeatures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "contains": {
                "const": "sandbox.lifecycle"
              }
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "enum": [
                "ephemeral",
                "durable"
              ]
            },
            "bindingRef": {
              "$ref": "#/$defs/refName"
            }
          }
        },
        "bindings": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "$ref": "#/$defs/refName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/refName"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxRunSeconds",
            "maxToolSeconds",
            "maxConcurrentRuns",
            "maxQueuedRuns",
            "maxRunsPerMinute",
            "maxEventsPerRun",
            "maxOutputBytes"
          ],
          "properties": {
            "maxRunSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrentRuns": {
              "type": "integer",
              "minimum": 1
            },
            "maxQueuedRuns": {
              "type": "integer",
              "minimum": 1
            },
            "maxRunsPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "maxEventsPerRun": {
              "type": "integer",
              "minimum": 5
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeApply": {
              "$ref": "#/$defs/hooks"
            },
            "afterReady": {
              "$ref": "#/$defs/hooks"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "properties": {
                  "placement": {
                    "const": "external"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "runtime": {
                "properties": {
                  "driver": {
                    "const": "python-remote-tools"
                  }
                },
                "not": {
                  "required": [
                    "profile"
                  ]
                }
              },
              "gateway": {
                "properties": {
                  "placement": {
                    "const": "fc-web"
                  }
                }
              },
              "state": {
                "properties": {
                  "profile": {
                    "const": "durable"
                  }
                }
              },
              "deployment": {
                "properties": {
                  "inline": {
                    "properties": {
                      "resources": {
                        "required": [
                          "gateway",
                          "worker",
                          "dispatcher"
                        ]
                      }
                    }
                  }
                }
              },
              "sandbox": {
                "properties": {
                  "requiredFeatures": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "exec.run"
                        }
                      },
                      {
                        "contains": {
                          "const": "files.rw"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "runtime": {
                "required": [
                  "profile"
                ],
                "properties": {
                  "driver": {
                    "const": "sandbox-local-api"
                  }
                }
              },
              "sandbox": {
                "properties": {
                  "requiredFeatures": {
                    "contains": {
                      "const": "ports.url"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gateway": {
                "properties": {
                  "placement": {
                    "const": "fc-web"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "deployment": {
                "required": [
                  "toolchainLock",
                  "accessRef"
                ],
                "properties": {
                  "adapter": {
                    "const": "serverless-devs-fc3"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "project"
                    ],
                    "not": {
                      "required": [
                        "inline"
                      ]
                    }
                  },
                  {
                    "required": [
                      "inline"
                    ],
                    "not": {
                      "required": [
                        "project"
                      ]
                    }
                  }
                ]
              },
              "state": {
                "properties": {
                  "profile": {
                    "const": "durable"
                  }
                },
                "required": [
                  "bindingRef"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "deployment": {
                "properties": {
                  "adapter": {
                    "const": "none"
                  }
                },
                "maxProperties": 1
              },
              "hooks": {
                "maxProperties": 0
              },
              "state": {
                "properties": {
                  "profile": {
                    "const": "ephemeral"
                  }
                },
                "maxProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "properties": {
                  "profile": {
                    "const": "durable"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "required": [
                  "bindingRef"
                ]
              }
            }
          }
        }
      ]
    },
    "serverlessProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "name",
        "resources"
      ],
      "properties": {
        "edition": {
          "const": "3.0.0"
        },
        "name": {
          "$ref": "#/$defs/refName"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "gateway": {
              "$ref": "#/$defs/serverlessFunction"
            },
            "worker": {
              "$ref": "#/$defs/serverlessFunction"
            },
            "dispatcher": {
              "$ref": "#/$defs/serverlessFunction"
            }
          }
        }
      }
    },
    "serverlessFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "props"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^fc3@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "props": {
          "type": "object",
          "minProperties": 1
        },
        "actions": {
          "type": "object"
        }
      }
    }
  },
  "description": "Sandbox template v3; optional application is consumed only by explicit application deployment."
}
