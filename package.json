{
  "name": "@agent-sandbox/cli",
  "version": "0.5.1",
  "description": "abx \u2014 the Agent Sandbox command-line interface (Node.js)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "abx": "dist/bin/abx.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "references",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node scripts/copy-standard-cli.mjs",
    "build:binary": "node scripts/build_binary.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/integration/test_{cli,nl_template_init}_e2e.test.ts'",
    "test:install": "node --test tests/install/install.test.mjs",
    "test:integration": "vitest run tests/integration",
    "dev": "tsx src/bin/abx.ts",
    "parity:coverage": "node scripts/parity-coverage.mjs",
    "check:hygiene": "bash scripts/check-no-local-paths.sh",
    "e2e": "node e2e/run.mjs",
    "e2e:offline": "node e2e/run.mjs --suite offline,provider-commands-offline,provider-operation-help-offline",
    "e2e:known-issues": "node e2e/known-issues/run.mjs",
    "e2e:providers": "bash e2e/providers/run.sh",
    "e2e:cleanup": "node e2e/cleanup.mjs",
    "e2e:standard": "node e2e/standard.mjs",
    "vendor:e2b": "node scripts/build-standard-cli.mjs",
    "test:standard-provenance": "node --test scripts/test-standard-provenance.mjs",
    "e2e:conditional": "node e2e/conditional.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alibaba-Agent-Sandbox/agent-sandbox.git"
  },
  "homepage": "https://github.com/alibaba-agent-sandbox/agent-sandbox#readme",
  "bugs": {
    "url": "https://github.com/alibaba-agent-sandbox/agent-sandbox/issues"
  },
  "keywords": [
    "sandbox",
    "cli",
    "abx",
    "agent-sandbox",
    "e2b",
    "agents",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@alicloud/fcsandbox20260509": "^1.5.1",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/openapi-core": "^1.0.8",
    "@inquirer/prompts": "^8.7.3",
    "ajv": "8.17.1",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "e2b": "2.55.0"
  }
}
